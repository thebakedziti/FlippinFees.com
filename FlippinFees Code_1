<style>
  :root {
    --bg: #0a0e1a;
    --bg-elev: #131826;
    --bg-elev-2: #1a2032;
    --border: #232a3d;
    --border-bright: #2f3854;
    --text: #e8ecf5;
    --text-dim: #8a93a8;
    --text-faint: #5a6378;
    --accent: #00d97a;
    --accent-dim: #00a85e;
    --warn: #ff5b5b;
    --warn-dim: #c93a3a;
    --gold: #f5b942;
  }
 
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
 
  html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-feature-settings: 'ss01', 'cv11';
    min-height: 100vh;
    overscroll-behavior: none;
  }
 
  body {
    background-image:
      radial-gradient(circle at 20% 0%, rgba(0, 217, 122, 0.08) 0%, transparent 40%),
      radial-gradient(circle at 80% 100%, rgba(255, 91, 91, 0.05) 0%, transparent 40%);
    background-attachment: fixed;
  }
 
  .app {
    max-width: 480px;
    margin: 0 auto;
    padding: 20px 16px 40px;
    padding-top: max(20px, env(safe-area-inset-top));
    padding-bottom: max(40px, env(safe-area-inset-bottom));
  }
 
  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding: 4px 4px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-mark {
    width: 36px; height: 36px;
    background: var(--accent);
    border-radius: 10px;
    display: grid; place-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 900;
    color: var(--bg);
    font-size: 20px;
    box-shadow: 0 0 20px rgba(0, 217, 122, 0.3);
  }
  .logo-text { font-weight: 800; font-size: 18px; letter-spacing: -0.02em; }
  .logo-text span { color: var(--accent); }
  .header-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-faint);
    text-align: right;
    line-height: 1.4;
  }
  .header-meta b { color: var(--accent); font-weight: 600; }
 
  /* Card */
  .card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 18px;
    margin-bottom: 14px;
  }
  .card-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    margin-bottom: 14px;
    font-weight: 600;
  }
 
  /* Inputs */
  .field { margin-bottom: 14px; }
  .field:last-child { margin-bottom: 0; }
  .field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .field-hint { font-size: 11px; color: var(--text-faint); font-family: 'JetBrains Mono', monospace; }
 
  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-prefix {
    position: absolute;
    left: 14px;
    color: var(--text-faint);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    pointer-events: none;
    font-size: 16px;
  }
  input[type="number"], input[type="text"], select {
    width: 100%;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 14px 14px 32px;
    color: var(--text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 17px;
    font-weight: 500;
    transition: border-color 0.15s, background 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }
  select {
    padding: 14px 36px 14px 14px;
    font-family: 'Inter', sans-serif;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%238a93a8' stroke-width='1.5' fill='none' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 16px center;
  }
  input:focus, select:focus {
    outline: none;
    border-color: var(--accent);
    background: #1f2638;
  }
  input::placeholder { color: var(--text-faint); }
  input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; }
 
  /* Toggles */
  .toggle-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .toggle {
    flex: 1;
    min-width: 0;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 8px;
    color: var(--text-dim);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }
  .toggle:hover { border-color: var(--border-bright); }
  .toggle.active {
    background: rgba(0, 217, 122, 0.12);
    border-color: var(--accent);
    color: var(--accent);
  }
  .toggle.active[data-status="below"] {
    background: rgba(255, 91, 91, 0.12);
    border-color: var(--warn);
    color: var(--warn);
  }
  .toggle.active[data-status="above"] {
    background: rgba(245, 185, 66, 0.10);
    border-color: var(--gold);
    color: var(--gold);
  }
 
  /* Result panel */
  .result-card {
    background: linear-gradient(140deg, #131826 0%, #1a2032 100%);
    border: 1px solid var(--border-bright);
    border-radius: 22px;
    padding: 22px;
    margin-bottom: 14px;
    position: relative;
    overflow: hidden;
  }
  .result-card::before {
    content: '';
    position: absolute;
    top: -1px; left: -1px; right: -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  .profit-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 4px;
  }
  .profit-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    font-weight: 600;
  }
  .profit-margin {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--text-dim);
    font-weight: 500;
  }
  .profit-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 4px 0 18px;
  }
  .profit-value.positive { color: var(--accent); }
  .profit-value.negative { color: var(--warn); }
  .profit-value.neutral { color: var(--text); }
 
  .breakdown {
    border-top: 1px solid var(--border);
    padding-top: 14px;
    display: grid;
    gap: 10px;
  }
  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }
  .breakdown-label {
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breakdown-label::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--text-faint);
  }
  .breakdown-row.fee .breakdown-label::before { background: var(--warn); }
  .breakdown-row.cost .breakdown-label::before { background: var(--gold); }
  .breakdown-row.income .breakdown-label::before { background: var(--accent); }
  .breakdown-value {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    color: var(--text);
  }
  .breakdown-row.fee .breakdown-value { color: var(--warn); }
  .breakdown-row.income .breakdown-value { color: var(--accent); }
 
  .breakdown-detail {
    font-size: 11px;
    color: var(--text-faint);
    font-family: 'JetBrains Mono', monospace;
    margin-left: 14px;
  }
 
  /* Effective fee meter */
  .meter {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .meter-header {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .meter-value {
    font-family: 'JetBrains Mono', monospace;
    color: var(--warn);
  }
  .meter-bar {
    height: 6px;
    background: var(--bg);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
  }
  .meter-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent) 0%, var(--gold) 50%, var(--warn) 100%);
    transition: width 0.3s ease;
    border-radius: 3px;
  }
 
  /* Footer */
  .footer {
    text-align: center;
    margin-top: 24px;
    font-size: 11px;
    color: var(--text-faint);
    line-height: 1.6;
  }
  .footer a { color: var(--text-dim); text-decoration: none; }
 
  /* Subtle reveal */
  .card, .result-card {
    animation: fadeUp 0.4s ease both;
  }
  .card:nth-child(2) { animation-delay: 0.05s; }
  .card:nth-child(3) { animation-delay: 0.1s; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
 
  /* Top Rated badge */
  .badge-row {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .badge-toggle {
    flex: 1;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px;
    font-size: 12px;
    color: var(--text-dim);
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
    font-weight: 600;
  }
  .badge-toggle.active {
    background: rgba(245, 185, 66, 0.1);
    border-color: var(--gold);
    color: var(--gold);
  }
</style>
</head>
<body>
<div class="app">
 
  <header class="header">
    <div class="logo">
      <div class="logo-mark">F</div>
      <div class="logo-text">Flippin<span>Fees</span></div>
    </div>
    <div class="header-meta">
      eBay Fee Calculator<br>
      <b>2026 rates</b>
    </div>
  </header>
 
  <!-- LISTING DETAILS -->
  <div class="card">
    <div class="card-title">Listing Details</div>
 
    <div class="field">
      <label class="field-label">
        <span>Sale Price (excl. tax)</span>
        <span class="field-hint">item price only</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">$</span>
        <input type="number" id="salePrice" placeholder="0.00" step="0.01" min="0" inputmode="decimal">
      </div>
    </div>
 
    <div class="field">
      <label class="field-label">
        <span>Category</span>
        <span class="field-hint" id="catRate">—</span>
      </label>
      <select id="category"></select>
    </div>
 
    <div class="field" style="margin-bottom: 4px;">
      <label class="field-label"><span>Store Subscription</span></label>
      <div class="toggle-row">
        <button class="toggle active" data-store="false">No Store / Starter</button>
        <button class="toggle" data-store="true">Basic Store +</button>
      </div>
    </div>
 
    <div class="field" style="margin-top: 14px; margin-bottom: 4px;">
      <label class="field-label">
        <span>Seller Performance Status</span>
        <span class="field-hint" id="statusHint">no fee adjustment</span>
      </label>
      <div class="toggle-row">
        <button class="toggle" data-status="below">Below Standard</button>
        <button class="toggle active" data-status="above">Above Standard</button>
        <button class="toggle" data-status="top">Top Rated</button>
      </div>
    </div>
 
    <div class="field" id="trsPlusField" style="margin-top: 14px; display: none;">
      <label class="field-label">
        <span>Top Rated Plus listing?</span>
        <span class="field-hint">1-day handling + 30-day free returns</span>
      </label>
      <div class="badge-row">
        <button class="badge-toggle active" data-trsplus="false">Standard Listing</button>
        <button class="badge-toggle" data-trsplus="true">TRS Plus −10%</button>
      </div>
    </div>
  </div>
 
  <!-- SHIPPING & TAX -->
  <div class="card">
    <div class="card-title">Shipping & Tax</div>
 
    <div class="field">
      <label class="field-label">
        <span>Shipping Charged to Buyer</span>
        <span class="field-hint">$0 = free shipping</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">$</span>
        <input type="number" id="shipCharged" placeholder="0.00" step="0.01" min="0" inputmode="decimal">
      </div>
    </div>
 
    <div class="field">
      <label class="field-label">
        <span>Your Actual Shipping Cost</span>
        <span class="field-hint">label + packaging</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">$</span>
        <input type="number" id="shipCost" placeholder="0.00" step="0.01" min="0" inputmode="decimal">
      </div>
    </div>
 
    <div class="field">
      <label class="field-label">
        <span>Sales Tax (paid by buyer)</span>
        <span class="field-hint" id="taxHint">collected by eBay · remitted to state</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">$</span>
        <input type="number" id="salesTax" placeholder="0.00" step="0.01" min="0" inputmode="decimal">
      </div>
    </div>
 
    <div class="field" style="margin-bottom: 0;">
      <label class="field-label"><span>Charge FVF on tax?</span></label>
      <div class="toggle-row">
        <button class="toggle active" data-taxfvf="false">No (typical)</button>
        <button class="toggle" data-taxfvf="true">Yes (some states)</button>
      </div>
    </div>
  </div>
 
  <!-- COSTS -->
  <div class="card">
    <div class="card-title">Your Costs</div>
 
    <div class="field">
      <label class="field-label">
        <span>Cost of Goods Sold (COGS)</span>
        <span class="field-hint">what you paid for item</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">$</span>
        <input type="number" id="cogs" placeholder="0.00" step="0.01" min="0" inputmode="decimal">
      </div>
    </div>
 
    <div class="field">
      <label class="field-label">
        <span>Promoted Listing Ad Rate</span>
        <span class="field-hint" id="promoHint">0%</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">%</span>
        <input type="number" id="promoRate" placeholder="0" step="0.1" min="0" max="20" inputmode="decimal">
      </div>
    </div>
 
    <div class="field">
      <label class="field-label">
        <span>Other Costs</span>
        <span class="field-hint">supplies, gas, etc</span>
      </label>
      <div class="input-wrap">
        <span class="input-prefix">$</span>
        <input type="number" id="otherCost" placeholder="0.00" step="0.01" min="0" inputmode="decimal">
      </div>
    </div>
  </div>
 
  <!-- RESULT -->
  <div class="result-card">
    <div class="profit-row">
      <span class="profit-label">Net Profit</span>
      <span class="profit-margin" id="margin">— margin</span>
    </div>
    <div class="profit-value neutral" id="profit">$0.00</div>
 
    <div class="breakdown">
      <div class="breakdown-row income">
        <span class="breakdown-label">Buyer Pays</span>
        <span class="breakdown-value" id="totalSale">$0.00</span>
      </div>
 
      <div class="breakdown-row" id="taxRow" style="display:none;">
        <span class="breakdown-label" style="color: var(--text-faint);">Sales tax (passes through to state)</span>
        <span class="breakdown-value" id="taxOut" style="color: var(--text-faint);">$0.00</span>
      </div>
 
      <div class="breakdown-row fee">
        <span class="breakdown-label">eBay Final Value Fee</span>
        <span class="breakdown-value" id="fvfTotal">−$0.00</span>
      </div>
      <div class="breakdown-detail" id="fvfDetail">—</div>
 
      <div class="breakdown-row fee" id="promoRow" style="display:none;">
        <span class="breakdown-label">Promoted Listing Fee</span>
        <span class="breakdown-value" id="promoFee">−$0.00</span>
      </div>
 
      <div class="breakdown-row cost">
        <span class="breakdown-label">Cost of Goods</span>
        <span class="breakdown-value" id="cogsOut">−$0.00</span>
      </div>
 
      <div class="breakdown-row cost">
        <span class="breakdown-label">Shipping (your cost)</span>
        <span class="breakdown-value" id="shipOut">−$0.00</span>
      </div>
 
      <div class="breakdown-row cost" id="otherRow" style="display:none;">
        <span class="breakdown-label">Other Costs</span>
        <span class="breakdown-value" id="otherOut">−$0.00</span>
      </div>
    </div>
 
    <div class="meter">
      <div class="meter-header">
        <span>Effective Fee Rate</span>
        <span class="meter-value" id="effRate">0.0%</span>
      </div>
      <div class="meter-bar">
        <div class="meter-fill" id="meterFill" style="width: 0%"></div>
      </div>
    </div>
  </div>
 
  <div class="footer">
    Rates as of 2026 · Always verify current rates at ebay.com/sellerfees<br>
    <span style="opacity:0.6">Add to home screen on iPhone or Android to use as an app</span>
  </div>
</div>
 
