    { id: 'menswomens',   name: 'Men\'s/Women\'s Bags & Accessories', no: 13.6,  store: 12.7 },
  ];
 
  // Per-order fee: $0.30 if total ≤ $10, else $0.40 (athletic shoes $150+ exempt)
  function perOrderFee(total, cat) {
    if (cat.noPerOrder) return 0;
    if (total <= 0) return 0;
    return total <= 10 ? 0.30 : 0.40;
  }
 
  // State
  let state = {
    salePrice: 0,
    shipCharged: 0,
    shipCost: 0,
    salesTax: 0,
    cogs: 0,
    promoRate: 0,
    otherCost: 0,
    catId: 'most',
    hasStore: false,
    sellerStatus: 'above', // 'below' | 'above' | 'top'
    trsPlus: false,        // listing-level TRS Plus discount (only when status = 'top')
    chargeFvfOnTax: false,
  };
 
  // Populate categories
  const catSelect = document.getElementById('category');
  CATEGORIES.forEach(c => {
    const opt = document.createElement('option');
    opt.value = c.id;
    opt.textContent = c.name;
    catSelect.appendChild(opt);
  });
 
  // Helpers
  const $ = id => document.getElementById(id);
  const fmt = n => '$' + (Math.round(n * 100) / 100).toFixed(2);
  const fmtNeg = n => n > 0 ? '−$' + (Math.round(n * 100) / 100).toFixed(2) : '$0.00';
 
  function getCat() { return CATEGORIES.find(c => c.id === state.catId) || CATEGORIES[0]; }
 
  function getRate() {
    const c = getCat();
    let rate = state.hasStore ? c.store : c.no;
    // TRS Plus discount: 10% off the % portion — only valid when Top Rated seller AND TRS Plus listing
    if (state.sellerStatus === 'top' && state.trsPlus) rate = rate * 0.9;
    return rate;
  }
 
  function calculate() {
    const cat = getCat();
    const itemPlusShip = state.salePrice + state.shipCharged;
    const buyerTotal = itemPlusShip + state.salesTax; // what buyer actually pays
    const fvfBase = state.chargeFvfOnTax ? itemPlusShip + state.salesTax : itemPlusShip;
    const rate = getRate();
 
    // Final value fee = (rate%) of fvfBase + per-order fee
    let fvfPercent = fvfBase * (rate / 100);
    // Heavy Equipment cap example
    if (cat.cap) fvfPercent = Math.min(fvfPercent, cat.cap);
    const perOrder = perOrderFee(fvfBase, cat);
 
    // Below Standard penalty: +6% of total sale, on top of normal FVF
    const belowStandardPenalty = state.sellerStatus === 'below' ? fvfBase * 0.06 : 0;
 
    const fvf = fvfPercent + perOrder + belowStandardPenalty;
 
    // Promoted Listing fee — % of item + shipping (NOT tax)
    const promoFee = itemPlusShip * (state.promoRate / 100);
 
    // Profit — tax does NOT count as seller income (eBay remits to state)
    const sellerRevenue = itemPlusShip; // tax bypasses seller
    const totalCosts = state.cogs + state.shipCost + state.otherCost;
    const profit = sellerRevenue - fvf - promoFee - totalCosts;
    const margin = sellerRevenue > 0 ? (profit / sellerRevenue) * 100 : 0;
 
    // Effective fee rate (eBay take vs. seller revenue)
    const effRate = sellerRevenue > 0 ? ((fvf + promoFee) / sellerRevenue) * 100 : 0;
 
    // Render
    $('catRate').textContent = `${rate.toFixed(2)}% rate`;
    $('totalSale').textContent = fmt(buyerTotal);
    $('fvfTotal').textContent = fmtNeg(fvf);
 
    // Build FVF detail string
    let detailParts = [];
    if (fvfBase > 0) {
      detailParts.push(`${rate.toFixed(2)}% × ${fmt(fvfBase)}`);
      if (perOrder > 0) detailParts.push(`+ ${fmt(perOrder)} per-order`);
      if (belowStandardPenalty > 0) detailParts.push(`+ ${fmt(belowStandardPenalty)} penalty`);
    }
    $('fvfDetail').textContent = detailParts.length ? detailParts.join(' ') : '—';
 
    // Status hint
    if (state.sellerStatus === 'below') {
      $('statusHint').textContent = '+6% penalty on FVF';
    } else if (state.sellerStatus === 'top') {
      $('statusHint').textContent = state.trsPlus ? '−10% off rate (TRS Plus)' : 'Top Rated · no discount yet';
    } else {
      $('statusHint').textContent = 'no fee adjustment';
    }
 
    // Show/hide TRS Plus field based on status
    $('trsPlusField').style.display = state.sellerStatus === 'top' ? 'block' : 'none';
 
    $('cogsOut').textContent = fmtNeg(state.cogs);
    $('shipOut').textContent = fmtNeg(state.shipCost);
 
    if (state.salesTax > 0) {
      $('taxRow').style.display = 'flex';
      $('taxOut').textContent = fmt(state.salesTax);
      $('taxHint').textContent = state.chargeFvfOnTax
        ? `+${fmt(state.salesTax * rate / 100)} extra FVF`
        : 'collected by eBay · remitted to state';
    } else {
      $('taxRow').style.display = 'none';
      $('taxHint').textContent = state.chargeFvfOnTax
        ? 'FVF will be charged on tax'
        : 'collected by eBay · remitted to state';
    }
 
    if (state.otherCost > 0) {
      $('otherRow').style.display = 'flex';
      $('otherOut').textContent = fmtNeg(state.otherCost);
    } else {
      $('otherRow').style.display = 'none';
    }
 
    if (promoFee > 0) {
      $('promoRow').style.display = 'flex';
      $('promoFee').textContent = fmtNeg(promoFee);
      $('promoHint').textContent = `${fmt(promoFee)} extra fee`;
    } else {
      $('promoRow').style.display = 'none';
      $('promoHint').textContent = '0%';
    }
 
    const profitEl = $('profit');
    profitEl.textContent = (profit < 0 ? '−$' : '$') + Math.abs(profit).toFixed(2);
    profitEl.className = 'profit-value ' + (
      profit > 0.005 ? 'positive' :
      profit < -0.005 ? 'negative' : 'neutral'
    );
 
    $('margin').textContent = sellerRevenue > 0
      ? `${margin >= 0 ? '+' : ''}${margin.toFixed(1)}% margin`
      : '— margin';
 
    $('effRate').textContent = effRate.toFixed(1) + '%';
    $('meterFill').style.width = Math.min(100, effRate * 4) + '%'; // 25% = full bar
  }
 
  // Wire inputs
  ['salePrice','shipCharged','shipCost','salesTax','cogs','promoRate','otherCost'].forEach(id => {
    $(id).addEventListener('input', e => {
      state[id] = parseFloat(e.target.value) || 0;
      calculate();
    });
  });
 
  catSelect.addEventListener('change', e => {
    state.catId = e.target.value;
    calculate();
  });
 
  document.querySelectorAll('.toggle[data-store]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.toggle[data-store]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.hasStore = btn.dataset.store === 'true';
      calculate();
    });
  });
 
  document.querySelectorAll('.toggle[data-status]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.toggle[data-status]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.sellerStatus = btn.dataset.status;
      // Reset TRS Plus when leaving Top Rated tier
      if (state.sellerStatus !== 'top') {
        state.trsPlus = false;
        document.querySelectorAll('.badge-toggle[data-trsplus]').forEach(b => b.classList.remove('active'));
        const stdBtn = document.querySelector('.badge-toggle[data-trsplus="false"]');
        if (stdBtn) stdBtn.classList.add('active');
      }
      calculate();
    });
  });
 
  document.querySelectorAll('.badge-toggle[data-trsplus]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.badge-toggle[data-trsplus]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.trsPlus = btn.dataset.trsplus === 'true';
      calculate();
    });
  });
 
  document.querySelectorAll('.toggle[data-taxfvf]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.toggle[data-taxfvf]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.chargeFvfOnTax = btn.dataset.taxfvf === 'true';
      calculate();
    });
  });
 
  // Initial render
  calculate();
</script>
</body>
</html>
